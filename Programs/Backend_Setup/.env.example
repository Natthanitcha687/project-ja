# -----------------------------------------------------------------------------
# SMA Warranty Platform - Environment Variables Template
# -----------------------------------------------------------------------------
# คำแนะนำ: ให้ก๊อปปี้ไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env จากนั้นเติมข้อมูลจริงลงไป
# -----------------------------------------------------------------------------

# 1. Database Connection (PostgreSQL)
# รูปแบบ: postgresql://[ชื่อผู้ใช้]:[รหัสผ่าน]@[ที่อยู่]:[พอร์ต]/[ชื่อฐานข้อมูล]?schema=public
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/Sma_warranty_dev?schema=public

# 2. Security (JWT)
# ใส่รหัสสุ่มยาวๆ เพื่อความปลอดภัย
JWT_SECRET=put-a-long-random-secret-here
JWT_EXPIRES_IN=7d

# 3. Application URLs
# กำหนด URL สำหรับการรันแบบ Local (ค่าเริ่มต้นปกติไม่ต้องแก้)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
APP_URL=http://localhost:4000

# 4. Default Admin Account
# ข้อมูลล็อกอินสำหรับ Admin ครั้งแรก
ADMIN_EMAIL=admin@example.com 
ADMIN_PASSWORD=Admin1234

# 5. Email Service (SMTP - แนะนำให้ใช้ Gmail)
# หมายเหตุ: สำหรับ Gmail ต้องใช้ 'App Password' 16 หลักเท่านั้น
SMTP_FROM="ชื่อผู้ส่ง <your-email@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
NODEMAILER_USER=your-email@gmail.com
NODEMAILER_PASS=your-16-digit-app-password

# 6. Email Features Options
USE_ETHEREAL=false
EMAIL_OTP_LOGIN=true
EMAIL_OTP_STEPUP_DAYS=7

# 7. Google OAuth (สำหรับระบบสมัครสมาชิกด้วย Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
